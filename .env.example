# ============================================================
# Health and Nursing Research Unit - PMNH Jazan Research Portal
# Environment Variables Configuration
# ============================================================

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Application Settings ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Health and Nursing Research Unit"
NEXT_PUBLIC_HOSPITAL_NAME="Prince Mohammed Bin Nasser Hospital"
NEXT_PUBLIC_HOSPITAL_LOCATION="Jazan, Kingdom of Saudi Arabia"

# --- Default Admin Credentials (Change immediately after first login) ---
# Username: research-unit PMNH
# Password: PMNH@Research2024! (set via Supabase dashboard)

# --- Email Configuration (Optional - for notifications) ---
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-email@hospital.gov.sa
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="PMNH Research Portal <research@hospital.gov.sa>"

# --- SMS Configuration (Optional - for OTP) ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+your-twilio-phone-number

# --- Storage Configuration ---
NEXT_PUBLIC_STORAGE_BUCKET=research-files
MAX_FILE_SIZE_MB=50

# --- Security ---
NEXTAUTH_SECRET=your-very-secure-secret-key-here
JWT_SECRET=your-jwt-secret-here
SESSION_TIMEOUT_MINUTES=60

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_SMS_OTP=false
NEXT_PUBLIC_ENABLE_EMAIL_NOTIFICATIONS=true
NEXT_PUBLIC_DEMO_MODE=true
